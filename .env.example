# Public hostname for short URLs and the permanent application redirect.
DULIO_BASE_HOSTNAME=3dreamstudio.com.br

# Host port exposed by the TLS-enabled Go container.
DULIO_HTTP_PORT=443

# Opaque authentication-session lifetime and graceful-shutdown timeout.
AUTH_TOKEN_TTL=24h
SHUTDOWN_TIMEOUT=10s

# Must be unique for every concurrently running ID-generating API instance.
SONYFLAKE_MACHINE_ID=0

# UID/GID used for the bind-mounted SQLite file on Linux.
# Docker Desktop users can keep these defaults.
DULIO_UID=1000
DULIO_GID=1000
